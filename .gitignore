# Haravan CLI
.haravan-cli_local.json

# Ignore toàn bộ workspace, chỉ track đúng thư mục cần
/*
!/seo/
!/app_script_admin/
!/.agents/
!/.gitignore
!/README.md


# Bên trong .agents chỉ track skills/seo-haravan-injector
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/seo-haravan-injector/

# Ignore file nặng & database
*.zip
*.rar
*.tar.gz
*.db
*.db.gz
*.sqlite
node_modules/
# Antigravity element annotations
.antigravity/
.ponytail-backup/
.vercel/
