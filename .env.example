# Telegram Bot Token nhận từ @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram User ID của Lâm (chỉ user này được quyền truy cập)
# Có thể lấy ID qua bot @userinfobot
TELEGRAM_OWNER_ID=123456789

# Đường dẫn database SQLite (mặc định trong thư mục data/)
DB_PATH=data/quet_vault.db

# Thư mục lưu snapshot backup SQLite
BACKUP_DIR=backups

# Ngưỡng cảnh báo giá cao bất thường (JPY) - chỉ để cảnh báo xác nhận
PRICE_HIGH_THRESHOLD_JPY=500000
